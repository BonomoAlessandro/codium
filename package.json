{
  "name": "codium",
  "productName": "Codium",
  "version": "0.1.0",
  "description": "Eine kleine eigene IDE im Stil von IntelliJ.",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "fetch:java": "node scripts/fetch-java-tools.mjs",
    "start": "node build.mjs && electron .",
    "dev": "node build.mjs --dev && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.mts",
    "test:ui": "node build.mjs && vitest run --config vitest.ui.config.mts",
    "test:packaged": "node build.mjs && node scripts/test-packaged.mjs",
    "dist": "node scripts/dist.mjs"
  },
  "build": {
    "appId": "ch.custom.codium",
    "productName": "Codium",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/node-pty/prebuilds/{darwin-*,win32-arm64}/**",
      "!node_modules/node-pty/{src,deps,third_party,scripts}/**",
      "!node_modules/node-pty/**/*.pdb",
      "!node_modules/@typescript/typescript-win32-x64/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "asarUnpack": [
      "node_modules/@vscode/ripgrep-win32-x64/**",
      "node_modules/node-pty/**",
      "node_modules/typescript-language-server/**"
    ],
    "extraResources": [
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "node_modules/@typescript/typescript-win32-x64/lib",
        "to": "typescript-native"
      },
      {
        "from": ".cache/java-tools/jdtls",
        "to": "jdtls",
        "filter": [
          "**/*",
          "!config_linux*/**",
          "!config_mac*/**",
          "!config_ss_*/**",
          "!.codium-extracted"
        ]
      },
      {
        "from": ".cache/java-tools/lombok.jar",
        "to": "lombok.jar"
      }
    ]
  },
  "dependencies": {
    "@typescript/typescript-win32-x64": "^7.0.2",
    "@vscode/ripgrep": "^1.18.0",
    "node-pty": "^1.1.0",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript-language-server": "^6.1.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "embedded-postgres": "18.6.0-beta.19",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.3.0",
    "monaco-editor": "^0.57.0",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "typescript6": "npm:typescript@^6.0.3",
    "vitest": "^5.1.1"
  }
}
